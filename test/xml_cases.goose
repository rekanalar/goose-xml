}

// expect_tostring_enc checks the bytes of tostring with an encoding.
fn expect_tostring_enc(id: i64, s: const u8[:], encoding: const u8[:], decl: i32, ok: bool, want: const u8[:]) {
    var nodes: xml::Node[>..] = [];
    var attrs: xml::Attr[>..] = [];
