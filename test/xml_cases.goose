    let res = xml::tostring_encoded(got, doc, doc.root, opts, encoding);
    if res != ok { print("write case ", id, " result ", res, " for ", encoding); assert(false); }
    if ok && got[..] != want {
        print("write case ", id, " differs for ", encoding, "\n  want ", want, "\n  got  ", got[..]);
        assert(false);
    }
