// expect_events checks the events of iterparse and the tree that it builds.
fn expect_events(id: i64, s: const u8[:], want_events: const u8[:], want_tree: const u8[:]) {
    var nodes: xml::Node[>..] = [];
    var attrs: xml::Attr[>..] = [];
    var text: u8[>..] = [];
    var ev: u8[>..] = [];
    let doc, ok = xml::iterparse(s, true, nodes, attrs, text) { kind, eid, a, b =>
        if kind != xml::TEV_TEXT {
            if ev.len > 0 { ev.push(' '); }
            if kind == xml::TEV_START { ev.append("S "); }
            else if kind == xml::TEV_END { ev.append("E "); }
            else if kind == xml::TEV_ATTR { ev.append("A "); }
            else if kind == xml::TEV_START_NS { ev.append("N "); }
            else if kind == xml::TEV_END_NS { ev.append("n "); }
            else if kind == xml::TEV_COMMENT { ev.append("C "); }
            else { ev.append("P "); }
            hex(ev, if kind == xml::TEV_END_NS { "" } else { a });
            if kind == xml::TEV_ATTR || kind == xml::TEV_START_NS || kind == xml::TEV_PI {
                ev.push(' ');
                hex(ev, b);
            }
        }
    };
    if !ok { print("event case ", id, " refused: ", s); assert(false); }
    if ev[..] != want_events {
        print("event case ", id, " events differ: ", s, "\n  want ", want_events, "\n  got  ", ev[..]);
        assert(false);
    }
    var raw: u8[>..] = [];
    walk(raw, doc, doc.root);
    var got: u8[>..] = [];
    merge(got, raw[..]);
    if got[..] != want_tree {
        print("event case ", id, " tree differs: ", s, "\n  want ", want_tree, "\n  got  ", got[..]);
        assert(false);
    }
}

// expect_events_bad checks that iterparse refuses the document.
fn expect_events_bad(id: i64, s: const u8[:]) {
    var nodes: xml::Node[>..] = [];
    var attrs: xml::Attr[>..] = [];
    var text: u8[>..] = [];
    let doc, ok = xml::iterparse(s, true, nodes, attrs, text) { kind, eid, a, b => };
    if ok { print("event case ", id, " accepted: ", s); assert(false); }
}

// expect_path_ns checks a path with a map of prefixes. An empty want with
// ok false means that the path is refused.
fn expect_path_ns(id: i64, s: const u8[:], path: const u8[:], prefixes: const u8[:][:], uris: const u8[:][:], ok: bool, want: const u8[:]) {
    var nodes: xml::Node[>..] = [];
    var attrs: xml::Attr[>..] = [];
    let doc, pok = xml::parse(s, nodes, attrs);
    if !pok { print("path case ", id, " refused the document"); assert(false); }
    var ids: i32[>..] = [];
    let n = xml::findall_path_ns(doc, doc.root, path, prefixes, uris, ids);
    if (n >= 0) != ok { print("path case ", id, " result ", n, " for path ", path); assert(false); }
    if !ok { return; }
    var got: u8[>..] = [];
    var i = 0;
    while i < ids.len {
        if i > 0 { got.push('|'); }
        tag_text(got, doc, ids[i]);
        i += 1;
    }
    if got[..] != want {
        print("path case ", id, " differs. path: ", path, "\n  want ", want, "\n  got  ", got[..]);
        assert(false);
    }
}

// expect_tostring_m checks the writer with a method and a default namespace.
// An ok of false means that the call must fail.
fn expect_tostring_m(id: i64, s: const u8[:], method: i32, dflt: const u8[:], short_empty: bool, ok: bool, want: const u8[:]) {
    var nodes: xml::Node[>..] = [];
    var attrs: xml::Attr[>..] = [];
    let doc, pok = xml::parse(s, nodes, attrs);
    if !pok { print("write case ", id, " refused the document"); assert(false); }
    var got: u8[>..] = [];
    let opts = xml::WriteOpts { xml_declaration: xml::DECL_AUTO as i32, short_empty_elements: short_empty, method: method, default_namespace: dflt };
    let res = xml::tostring(got, doc, doc.root, opts);
    if res != ok { print("write case ", id, " result ", res, " for ", s); assert(false); }
    if ok && got[..] != want {
        print("write case ", id, " differs. doc: ", s, "\n  want ", want, "\n  got  ", got[..]);
        assert(false);
    }
}

fn check_xml_cases() {
    expect_ok(0, "\x3c\x61\x2f\x3e", "E{a;}/");
    expect_ok(1, "\x3c\x61\x3e\x3c\x2f\x61\x3e", "E{a;}/");
    expect_ok(2, "\x3c\x61\x3e\x78\x3c\x2f\x61\x3e", "E{a;}|78/");
    expect_ok(3, "\x3c\x61\x20\x78\x3d\x22\x31\x22\x20\x79\x3d\x27\x32\x27\x3e\x74\x3c\x2f\x61\x3e", "E{a;x=31;y=32}|74/");
    expect_ok(4, "\x3c\x61\x3e\x3c\x62\x2f\x3e\x3c\x63\x3e\x78\x3c\x2f\x63\x3e\x3c\x2f\x61\x3e", "E{a;}E{b;}/E{c;}|78//");
    expect_ok(5, "\x3c\x61\x3e\x78\x0d\x0a\x79\x3c\x2f\x61\x3e", "E{a;}|780a79/");
    expect_ok(6, "\x3c\x61\x3e\x78\x0d\x79\x3c\x2f\x61\x3e", "E{a;}|780a79/");
    expect_ok(7, "\x3c\x61\x20\x78\x3d\x22\x61\x09\x62\x0a\x63\x0d\x0a\x64\x22\x2f\x3e", "E{a;x=61206220632064}/");
    expect_ok(8, "\x3c\x61\x3e\x20\x20\x3c\x2f\x61\x3e", "E{a;}|2020/");
    expect_ok(9, "\x20\x20\x3c\x61\x2f\x3e", "E{a;}/");
    expect_ok(10, "\x0a\x3c\x61\x2f\x3e\x0a", "E{a;}/");
    expect_ok(11, "\x3c\x61\x20\x78\x20\x3d\x20\x22\x31\x22\x20\x2f\x3e", "E{a;x=31}/");
    expect_ok(12, "\x3c\x61\x0a\x20\x78\x3d\x22\x31\x22\x0a\x2f\x3e", "E{a;x=31}/");
